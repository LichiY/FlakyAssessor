test_code:

private static void testStandalone(Class<? extends Command> clazz) throws Exception {
    for (Class<? extends Command> commandClass : Commands.TESTS_STANDALONE) {
        String fullHelp = HelpSupport.getCommandHelp(new AeshCommandContainerBuilder().create(commandClass).getParser());
        String expected = ((TestCommand) commandClass.newInstance()).getSynopsis();
        String actual = fullHelp.replaceAll("\\s+", " ").trim();
        expected = expected.replaceAll("\\s+", " ").trim();
        
        // Remove "SYNOPSIS" prefix if present
        if (actual.startsWith("SYNOPSIS ")) {
            actual = actual.substring("SYNOPSIS ".length());
        }
        
        // Split options and compare unordered using TreeSet for deterministic order
        String[] actualParts = actual.split("\\|");
        String[] expectedParts = expected.split("\\|");
        
        Set<String> actualSet = new TreeSet<>(Arrays.asList(actualParts));
        Set<String> expectedSet = new TreeSet<>(Arrays.asList(expectedParts));
        
        Assert.assertEquals(commandClass.getName() + " option count mismatch", expectedSet.size(), actualSet.size());
        Assert.assertEquals(commandClass.getName() + " options mismatch", expectedSet, actualSet);
    }
}


