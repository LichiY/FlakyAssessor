public void testStandalone() throws Exception {
    for (Class<? extends Command> clazz : Commands.TESTS_STANDALONE) {
        String fullHelp = HelpSupport.getCommandHelp(new AeshCommandContainerBuilder().create(clazz).getParser());
        String expected = ((TestCommand) clazz.newInstance()).getSynopsis();
        String actual = fullHelp.replaceAll("\\s+", " ").trim();
        expected = expected.replaceAll("\\s+", " ").trim();
        
        // Split options and compare unordered
        String[] actualParts = actual.split("\\|");
        String[] expectedParts = expected.split("\\|");
        
        Assert.assertEquals(clazz.getName() + " option count mismatch", expectedParts.length, actualParts.length);
        Assert.assertThat(clazz.getName() + " options mismatch", 
            Arrays.asList(actualParts), 
            Matchers.containsInAnyOrder(expectedParts));
    }
}


