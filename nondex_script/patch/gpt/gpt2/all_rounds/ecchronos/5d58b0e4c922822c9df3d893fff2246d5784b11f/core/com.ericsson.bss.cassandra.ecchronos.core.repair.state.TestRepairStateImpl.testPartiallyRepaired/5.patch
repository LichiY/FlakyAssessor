public void testPartiallyRepaired() {
    long expectedAtLeastRepairedAt = System.currentTimeMillis();
    VnodeRepairStates vnodeRepairStatesBase = VnodeRepairStates.newBuilder()
        .withVnodeRepairState(new VnodeRepairState(new TokenRange(1L, 2L), Collections.singletonList(mockReplica), expectedAtLeastRepairedAt))
        .build();

    RepairStateSnapshot repairStateSnapshot = new RepairStateSnapshot(
        expectedAtLeastRepairedAt,
        Collections.singletonList(mockReplicaRepairGroup),
        vnodeRepairStatesBase
    );

    assertThat(repairStateSnapshot.getVnodeRepairStates().getVnodeRepairStates())
        .containsExactlyInAnyOrderElementsOf(vnodeRepairStatesBase.combineWithRepairedAt(repairStateSnapshot.lastCompletedAt()).getVnodeRepairStates());
    assertRepairStateSnapshot(repairStateSnapshot, expectedAtLeastRepairedAt, Collections.singletonList(mockReplicaRepairGroup), vnodeRepairStatesBase);
}


