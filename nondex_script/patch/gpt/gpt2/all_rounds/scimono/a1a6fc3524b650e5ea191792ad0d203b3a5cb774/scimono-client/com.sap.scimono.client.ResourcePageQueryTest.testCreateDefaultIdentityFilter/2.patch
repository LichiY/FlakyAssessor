public void testCreateDefaultIdentityFilter() {
    String resultRequestPath = ResourcePageQuery.identityPageQuery().apply(webTarget).getUri().toString();
    assertThat(resultRequestPath).contains(DEFAULT_URL);
    
    Map<String, String> queryParams = new LinkedHashMap<>();
    Arrays.stream(resultRequestPath.split("\\?")[1].split("&"))
          .map(param -> param.split("="))
          .forEach(pair -> queryParams.put(pair[0], pair[1]));
    
    assertThat(queryParams)
        .containsEntry("startId", "00000000-0000-1000-9000-000000000000")
        .containsEntry("count", "100");
}


