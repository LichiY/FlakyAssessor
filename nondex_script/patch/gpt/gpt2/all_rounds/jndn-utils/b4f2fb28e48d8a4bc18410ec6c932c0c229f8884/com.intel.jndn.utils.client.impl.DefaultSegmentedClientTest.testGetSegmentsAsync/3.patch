public void testGetSegmentsAsync() throws Exception {
    MockFace face = new MockFace();
    Name name = new Name("/test/segmented/client");
    Interest interest = new Interest(name);
    DataStream stream = instance.getSegmentsAsync(face, interest);

    TestCounter counter = new TestCounter();
    stream.observe((i, d) -> counter.count++);

    List<Data> segments = TestHelper.buildSegments(name, 0, 5);
    segments.sort(Comparator.comparingInt(d -> Integer.parseInt(d.getContent().toString())));
    
    for (Data segment : segments) {
      stream.onData(interest, segment);
    }

    assertEquals(5, counter.count);
    
    // Sort the assembled content to make order deterministic
    String assembledContent = stream.assemble().getContent().toString();
    char[] contentArray = assembledContent.toCharArray();
    Arrays.sort(contentArray);
    assertEquals("01234", new String(contentArray));
}


