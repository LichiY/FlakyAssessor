public void createConfigFromResourceFile() throws MojoExecutionException, URISyntaxException, JsonProcessingException {
    URL configFile = this.getClass().getResource(testConfigFile);
    File testConfigJSON = new File(configFile.toURI());
    TestConfigurationWrapper testConfig = new TestConfigurationWrapper(testConfigJSON, "test-execution");
    DocumentContext parsedJson = JsonPath.parse(testConfig.getFullConfig());
    
    assertThat(parsedJson.read("$.executionID", String.class)).isEqualTo("test-execution");
    assertThat((Object) parsedJson.read("$.jmeterDirectoryPath")).isNull();
    assertThat((Object) parsedJson.read("$.runtimeJarName")).isNull();
    assertThat(parsedJson.read("$.resultsOutputIsCSVFormat", Boolean.class)).isFalse();
    assertThat(parsedJson.read("$.generateReports", Boolean.class)).isFalse();
    assertThat(parsedJson.read("$.resultFilesLocations", List.class)).isEmpty();
    assertThat((Object) parsedJson.read("$.propertiesMap")).isNull();
    assertThat((Object) parsedJson.read("$.jmeterWorkingDirectoryPath")).isNull();
}

