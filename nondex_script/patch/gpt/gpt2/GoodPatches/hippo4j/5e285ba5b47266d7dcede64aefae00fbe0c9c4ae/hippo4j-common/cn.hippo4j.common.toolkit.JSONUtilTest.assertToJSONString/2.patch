public void assertToJSONString() {
    Assert.assertNull(JSONUtil.toJSONString(null));
    
    DocumentContext expectedJson = JsonPath.parse(EXPECTED_FOO_JSON);
    DocumentContext actualJson = JsonPath.parse(JSONUtil.toJSONString(EXPECTED_FOO));
    
    assertThatJson(actualJson.jsonString()).isEqualTo(expectedJson.jsonString());
}

