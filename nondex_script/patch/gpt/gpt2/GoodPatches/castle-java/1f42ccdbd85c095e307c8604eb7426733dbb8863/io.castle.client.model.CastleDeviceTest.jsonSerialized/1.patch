test_code:
public void jsonSerialized() {
    // Given
    CastleDevice device = new CastleDevice();
    device.setId("d_id");
    device.setName("d_name");
    device.setType("d_type");
    device.setManufacturer("d_manufacturer");
    device.setModel("d_model");

    // When
    String payloadJson = model.getGson().toJson(device);
    DocumentContext jsonContext = JsonPath.parse(payloadJson);

    // Then
    Assertions.assertThat(jsonContext.read("$.id", String.class)).isEqualTo("d_id");
    Assertions.assertThat(jsonContext.read("$.name", String.class)).isEqualTo("d_name");
    Assertions.assertThat(jsonContext.read("$.type", String.class)).isEqualTo("d_type");
    Assertions.assertThat(jsonContext.read("$.manufacturer", String.class)).isEqualTo("d_manufacturer");
    Assertions.assertThat(jsonContext.read("$.model", String.class)).isEqualTo("d_model");
}

