test_code:
public void testParseNestedDataSchemaless() throws Exception {
    String json = "{\"id\":\"1\",\"someOtherId\":\"2\",\"someIntColumn\":3,\"someLongColumn\":4,\"someFloatColumn\":5.0,\"someBytesColumn\":\"bytes\",\"isValid\":true,\"description\":\"desc\",\"eventType\":\"type\",\"foo\":{\"bar\":\"baz\"}}";
    
    com.fasterxml.jackson.databind.ObjectMapper mapper = new com.fasterxml.jackson.databind.ObjectMapper();
    Map<String, Object> parsed = mapper.readValue(json, new com.fasterxml.jackson.core.type.TypeReference<Map<String, Object>>() {});
    Set<String> expectedKeys = new LinkedHashSet<>(Arrays.asList(
        "id", "someOtherId", "someIntColumn", "someLongColumn", "someFloatColumn", 
        "someBytesColumn", "isValid", "description", "eventType", "foo"
    ));
    
    assertThat(parsed.keySet()).containsExactlyInAnyOrderElementsOf(expectedKeys);
}

