public void testNewDocumentXml() throws Exception {
    HopSvgGraphics2D graphics2D = HopSvgGraphics2D.newDocument();
    String actualXml = graphics2D.toXml();
    
    // Normalize both expected and actual XML by sorting attributes alphabetically
    String expected = BASIC_SVG_XML
        .replaceAll("shape-rendering=\"auto\" stroke-opacity=\"1\"", "stroke-opacity=\"1\" shape-rendering=\"auto\"")
        .replaceAll("stroke-dashoffset=\"0\" image-rendering=\"auto\"", "image-rendering=\"auto\" stroke-dashoffset=\"0\"")
        .replaceAll("color-rendering=\"auto\" color-interpolation", "color-interpolation=\"auto\" color-rendering");
    
    // Compare XML strings while ignoring attribute order
    DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance();
    DocumentBuilder builder = factory.newDocumentBuilder();
    Document expectedDoc = builder.parse(new InputSource(new StringReader(expected)));
    Document actualDoc = builder.parse(new InputSource(new StringReader(actualXml)));
    
    expectedDoc.normalizeDocument();
    actualDoc.normalizeDocument();
    
    assertEquals(expectedDoc.getDocumentElement().getTextContent(), 
                actualDoc.getDocumentElement().getTextContent());
    
    NamedNodeMap expectedAttrs = expectedDoc.getDocumentElement().getAttributes();
    NamedNodeMap actualAttrs = actualDoc.getDocumentElement().getAttributes();
    
    assertEquals(expectedAttrs.getLength(), actualAttrs.getLength());
    
    Map<String, String> expectedAttrMap = new LinkedHashMap<>();
    Map<String, String> actualAttrMap = new LinkedHashMap<>();
    
    for (int i = 0; i < expectedAttrs.getLength(); i++) {
        Node attr = expectedAttrs.item(i);
        expectedAttrMap.put(attr.getNodeName(), attr.getNodeValue());
    }
    
    for (int i = 0; i < actualAttrs.getLength(); i++) {
        Node attr = actualAttrs.item(i);
        actualAttrMap.put(attr.getNodeName(), attr.getNodeValue());
    }
    
    assertEquals(expectedAttrMap, actualAttrMap);
}

