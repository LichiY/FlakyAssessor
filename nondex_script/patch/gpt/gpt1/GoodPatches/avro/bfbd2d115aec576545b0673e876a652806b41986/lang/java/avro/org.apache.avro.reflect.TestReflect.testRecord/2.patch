public void testRecord() throws Exception {
    String expectedJson = "{\"type\":\"record\",\"name\":\"R\",\"namespace\":" + "\"org.apache.avro.reflect.TestReflect\",\"fields\":["
            + "{\"name\":\"a\",\"type\":\"int\"}," + "{\"name\":\"b\",\"type\":\"long\"}]}";
    String actualJson = ReflectData.get().getSchema(R.class).toString();
    
    Configuration config = Configuration.defaultConfiguration()
            .addOptions(Option.SUPPRESS_EXCEPTIONS)
            .addOptions(Option.ALWAYS_RETURN_LIST);
    
    Object expected = JsonPath.using(config).parse(expectedJson).json();
    Object actual = JsonPath.using(config).parse(actualJson).json();
    
    JSONAssert.assertEquals(expectedJson, actualJson, JSONCompareMode.NON_EXTENSIBLE);
}

