test_code:
public void testSimpleReflectionStatics() {
    final SimpleReflectionStaticFieldsFixture instance1 = new SimpleReflectionStaticFieldsFixture();
    String baseString = this.toBaseString(instance1);
    
    String actual1 = ReflectionToStringBuilder.toString(instance1, null, false, true, SimpleReflectionStaticFieldsFixture.class);
    assertThat(actual1, allOf(
        containsString("staticString=staticString"),
        containsString("staticInt=12345"),
        startsWith(baseString)
    ));
    
    String actual2 = ReflectionToStringBuilder.toString(instance1, null, true, true, SimpleReflectionStaticFieldsFixture.class);
    assertThat(actual2, allOf(
        containsString("staticString=staticString"),
        containsString("staticInt=12345"),
        startsWith(baseString)
    ));
    
    String actual3 = this.toStringWithStatics(instance1, null, SimpleReflectionStaticFieldsFixture.class);
    assertThat(actual3, allOf(
        containsString("staticString=staticString"),
        containsString("staticInt=12345"),
        startsWith(baseString)
    ));
    
    String actual4 = this.toStringWithStatics(instance1, null, SimpleReflectionStaticFieldsFixture.class);
    assertThat(actual4, allOf(
        containsString("staticString=staticString"),
        containsString("staticInt=12345"),
        startsWith(baseString)
    ));
}

