public void encodesObject() {
    new JsonEncoder().encode(jsonObject, JSONObject.class, requestTemplate);
    String actualJson = new String(requestTemplate.body(), UTF_8);
    LinkedHashMap<String, Object> parsed = JsonPath.parse(actualJson).read("$");
    assertEquals("b", parsed.get("a"));
    assertEquals(1, parsed.get("c"));
}

