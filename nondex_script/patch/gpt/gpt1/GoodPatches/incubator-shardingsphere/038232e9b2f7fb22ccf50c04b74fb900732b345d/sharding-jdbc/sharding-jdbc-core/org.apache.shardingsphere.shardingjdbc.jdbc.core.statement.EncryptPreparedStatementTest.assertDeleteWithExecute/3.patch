public void assertDeleteWithExecute() throws SQLException {
    try (PreparedStatement statement = getEncryptConnection().prepareStatement(DELETE_SQL)) {
        statement.setObject(1, 'a');
        statement.setObject(2, 1);
        int affectedRows = statement.executeUpdate();
        assertThat(affectedRows, is(1));
    }
    try (PreparedStatement queryStatement = getEncryptConnection().prepareStatement("SELECT COUNT(*) FROM t_encrypt");
         ResultSet resultSet = queryStatement.executeQuery()) {
        resultSet.next();
        int count = resultSet.getInt(1);
        assertThat(count, greaterThanOrEqualTo(1));
    }
}

