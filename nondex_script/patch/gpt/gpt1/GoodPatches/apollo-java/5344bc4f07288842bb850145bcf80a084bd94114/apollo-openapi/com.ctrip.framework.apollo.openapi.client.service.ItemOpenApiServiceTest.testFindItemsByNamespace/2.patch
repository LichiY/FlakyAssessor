test_code:
public void testFindItemsByNamespace() throws Exception {
    final int page = 0;
    final int size = 50;
    final ArgumentCaptor<HttpGet> request = ArgumentCaptor.forClass(HttpGet.class);

    itemOpenApiService.findItemsByNamespace(someAppId, someEnv, someCluster, someNamespace, page, size);

    verify(httpClient, times(1)).execute(request.capture());

    HttpGet get = request.getValue();
    String uri = get.getURI().toString();
    
    String expectedPrefix = String.format("%s/envs/%s/apps/%s/clusters/%s/namespaces/%s/items?", 
            someBaseUrl, someEnv, someAppId, someCluster, someNamespace);
    assertTrue(uri.startsWith(expectedPrefix));
    assertThat(uri, containsString("page=" + page));
    assertThat(uri, containsString("size=" + size));
}

