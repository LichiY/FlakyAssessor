public void serializeFloat() throws IOException, org.json.JSONException {
    JSONAssert.assertEquals("{\"@type\":\"float\",\"@value\":1.0}", objectMapper.writeValueAsString(ValueReference.of(1.0f)), JSONCompareMode.STRICT);
    JSONAssert.assertEquals("{\"@type\":\"float\",\"@value\":42.4}", objectMapper.writeValueAsString(ValueReference.of(42.4f)), JSONCompareMode.STRICT);
}

