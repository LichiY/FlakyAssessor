public void serializeInteger() throws IOException, JSONException {
    String expected1 = "{\"@type\":\"integer\",\"@value\":1}";
    String actual1 = objectMapper.writeValueAsString(ValueReference.of(1));
    JSONAssert.assertEquals(expected1, actual1, JSONCompareMode.NON_EXTENSIBLE);

    String expected42 = "{\"@type\":\"integer\",\"@value\":42}";
    String actual42 = objectMapper.writeValueAsString(ValueReference.of(42));
    JSONAssert.assertEquals(expected42, actual42, JSONCompareMode.NON_EXTENSIBLE);
}

