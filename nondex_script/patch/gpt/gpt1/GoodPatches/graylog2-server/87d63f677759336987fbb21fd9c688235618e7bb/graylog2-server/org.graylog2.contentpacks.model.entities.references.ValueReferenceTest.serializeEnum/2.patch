public void serializeEnum() throws IOException {
    String jsonA = objectMapper.writeValueAsString(ValueReference.of(TestEnum.A));
    assertThat((Object) JsonPath.read(jsonA, "$.@type")).isEqualTo("string");
    assertThat((Object) JsonPath.read(jsonA, "$.@value")).isEqualTo("A");
    
    String jsonB = objectMapper.writeValueAsString(ValueReference.of(TestEnum.B));
    assertThat((Object) JsonPath.read(jsonB, "$.@type")).isEqualTo("string");
    assertThat((Object) JsonPath.read(jsonB, "$.@value")).isEqualTo("B");
}

