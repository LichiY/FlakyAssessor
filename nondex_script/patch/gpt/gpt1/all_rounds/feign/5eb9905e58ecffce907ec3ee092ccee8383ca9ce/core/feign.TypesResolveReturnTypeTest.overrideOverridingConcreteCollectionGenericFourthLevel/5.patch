public void overrideOverridingConcreteCollectionGenericFourthLevel() {
    Method[] methods = FourthLevel.class.getMethods();
    Arrays.sort(methods, Comparator.comparing(Method::getName));
    Method targetMethod = Arrays.stream(methods)
        .filter(m -> m.getGenericReturnType() instanceof ParameterizedType)
        .findFirst()
        .orElseThrow(() -> new AssertionError("No method with ParameterizedType return type found"));
    
    Type returnType = targetMethod.getGenericReturnType();
    assertTrue(returnType instanceof ParameterizedType);
    ParameterizedType parameterizedType = (ParameterizedType) returnType;
    Type[] typeArguments = parameterizedType.getActualTypeArguments();
    assertEquals(1, typeArguments.length);
    assertEquals(String.class, typeArguments[0]);
}


