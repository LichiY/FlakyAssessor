public void testReflectionHashCodeExcludeFields() {
    ReflectionTestObject x = new ReflectionTestObject();
    x.setFieldA(5);
    x.setFieldB(6);
    x.setFieldC(7);

    Field[] fields = ReflectionTestObject.class.getDeclaredFields();
    Arrays.sort(fields, Comparator.comparing(Field::getName));
    int hash = 0;
    for (Field field : fields) {
        if (!field.getName().equals("fieldB")) {
            field.setAccessible(true);
            try {
                Object value = field.get(x);
                hash = HashCodeBuilder.reflectionHashCode(hash, value);
            } catch (IllegalAccessException e) {
