public void testReflectionHashCodeExcludeFields() {
    class X {
        private int x = 1;
        private int y = 2;
        private int z = 3;
    }
    X x = new X();
    
    // Get fields in deterministic order
    Field[] fields = x.getClass().getDeclaredFields();
    Arrays.sort(fields, Comparator.comparing(Field::getName));
    
    int hash = 17;
    for (Field field : fields) {
        field.setAccessible(true);
        try {
            Object value = field.get(x);
            if (value instanceof Number) {
                hash = hash * 37 + ((Number) value).intValue();
            } else {
                hash = hash * 37 + value.hashCode();
            }
        } catch (IllegalAccessException e) {
            throw new RuntimeException(e);
        }
    }
    
    assertEquals(hash, HashCodeBuilder.reflectionHashCode(x));
}


