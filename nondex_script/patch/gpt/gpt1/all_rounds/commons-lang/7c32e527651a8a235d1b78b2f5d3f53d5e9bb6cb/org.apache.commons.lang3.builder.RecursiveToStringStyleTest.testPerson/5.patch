public void testPerson() {
    final Person p = new Person();
    p.name = "John Doe";
    p.age = 33;
    p.smoker = false;
    p.job = new Job();
    p.job.title = "Manager";
    
    final String actual = new ReflectionToStringBuilder(p, new RecursiveToStringStyle() {
        @Override
        protected void appendDetail(StringBuffer buffer, String fieldName, Object value) {
            if (value instanceof Job) {
                Job job = (Job) value;
                buffer.append("Job[title=").append(job.title).append("]");
            } else {
                super.appendDetail(buffer, fieldName, value);
            }
        }
    }).toString();
    
    assertThat(actual, allOf(
        containsString("name=John Doe"),
        containsString("age=33"),
        containsString("smoker=false"),
        containsString("title=Manager"),
        containsString(p.getClass().getName()),
        containsString(Integer.toHexString(System.identityHashCode(p))),
        endsWith("]")
    ));
}


