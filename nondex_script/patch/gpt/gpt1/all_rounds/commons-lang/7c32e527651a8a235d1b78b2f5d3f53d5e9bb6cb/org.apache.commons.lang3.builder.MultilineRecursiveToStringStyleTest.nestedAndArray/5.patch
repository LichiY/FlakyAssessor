public void nestedAndArray() {
    final Account acc = new Account();
    final Transaction tx1 = new Transaction("2014.10.14", 100);
    final Transaction tx2 = new Transaction("2014.10.15", 50);
    acc.transactions = new LinkedHashSet<>();
    acc.transactions.add(tx1);
    acc.transactions.add(tx2);
    final String actual = toString(acc);
    
    // Verify owner is present
    org.junit.Assert.assertTrue(actual.contains("owner=<null>"));
    
    // Verify transactions container
    org.junit.Assert.assertTrue(actual.contains("transactions=" + getClassPrefix(acc.transactions)));
    
    // Verify transaction 1
    org.junit.Assert.assertTrue(actual.contains("amount=100.0") || actual.contains("amount=50.0"));
    org.junit.Assert.assertTrue(actual.contains("date=2014.10.14") || actual.contains("date=2014.10.15"));
    
    // Verify transaction 2
    org.junit.Assert.assertTrue(actual.contains("amount=100.0") || actual.contains("amount=50.0"));
    org.junit.Assert.assertTrue(actual.contains("date=2014.10.14") || actual.contains("date=2014.10.15"));
}


