public void testSimpleReflectionStatics() {
    final SimpleReflectionStaticFieldsFixture instance1 = new SimpleReflectionStaticFieldsFixture();
    String expected = this.toBaseString(instance1) + "[staticString=staticString,staticInt=12345]";
    String actual1 = ReflectionToStringBuilder.toString(instance1, null, false, true, SimpleReflectionStaticFieldsFixture.class);
    assertTrue(actual1.contains("staticString=staticString") && actual1.contains("staticInt=12345") && actual1.startsWith(this.toBaseString(instance1)));
    
    String actual2 = ReflectionToStringBuilder.toString(instance1, null, true, true, SimpleReflectionStaticFieldsFixture.class);
    assertTrue(actual2.contains("staticString=staticString") && actual2.contains("staticInt=12345") && actual2.startsWith(this.toBaseString(instance1)));
    
    String actual3 = this.toStringWithStatics(instance1, null, SimpleReflectionStaticFieldsFixture.class);
    assertTrue(actual3.contains("staticString=staticString") && actual3.contains("staticInt=12345") && actual3.startsWith(this.toBaseString(instance1)));
    
    String actual4 = this.toStringWithStatics(instance1, null, SimpleReflectionStaticFieldsFixture.class);
    assertTrue(actual4.contains("staticString=staticString") && actual4.contains("staticInt=12345") && actual4.startsWith(this.toBaseString(instance1)));
}


