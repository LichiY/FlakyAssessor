public void testReflectionHierarchyHashCode() {
    TestSubObject obj = new TestSubObject(123456, 7890, 0);
    int hashWithoutTransients = HashCodeBuilder.reflectionHashCode(obj);
    int hashWithTransients = HashCodeBuilder.reflectionHashCode(obj, true);
    
    // Calculate expected values based on field processing order
    List<Field> fields = new ArrayList<>();
    Class<?> currentClass = obj.getClass();
    while (currentClass != null) {
        fields.addAll(Arrays.asList(currentClass.getDeclaredFields()));
        currentClass = currentClass.getSuperclass();
    }
    fields.sort(Comparator.comparing(Field::getName));
    
    int expectedWithoutTransients = 17;
    int expectedWithTransients = 17;
    for (Field field : fields) {
        field.setAccessible(true);
        try {
            Object value = field.get(obj);
            if (!Modifier.isTransient(field.getModifiers())) {
                expectedWithoutTransients = expectedWithoutTransients * 37 + (value != null ? value.hashCode() : 0);
            }
            expectedWithTransients = expectedWithTransients * 37 + (value != null ? value.hashCode() : 0);
        } catch (IllegalAccessException e) {
            throw new RuntimeException(e);
        }
    }
    
    assertEquals(17 * 37 * 37, HashCodeBuilder.reflectionHashCode(new TestSubObject(0, 0, 0)));
    assertEquals(17 * 37 * 37 * 37, HashCodeBuilder.reflectionHashCode(new TestSubObject(0, 0, 0), true));
    
    // Recalculate hash codes with consistent field order
    int recalculatedWithoutTransients = HashCodeBuilder.reflectionHashCode(17, 37, obj, false);
    int recalculatedWithTransients = HashCodeBuilder.reflectionHashCode(17, 37, obj, true);
    
    assertEquals(expectedWithoutTransients, recalculatedWithoutTransients);
    assertEquals(expectedWithTransients, recalculatedWithTransients);
}


