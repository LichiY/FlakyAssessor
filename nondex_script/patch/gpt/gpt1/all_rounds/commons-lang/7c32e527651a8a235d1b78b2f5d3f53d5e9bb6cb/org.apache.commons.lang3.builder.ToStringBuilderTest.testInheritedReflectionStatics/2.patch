public void testInheritedReflectionStatics() {
    final InheritedReflectionStaticFieldsFixture instance1 = new InheritedReflectionStaticFieldsFixture();
    String result1 = ReflectionToStringBuilder.toString(instance1, null, false, true, InheritedReflectionStaticFieldsFixture.class);
    assertThat(result1, allOf(
