public void testInheritedReflectionStatics() {
    final InheritedReflectionStaticFieldsFixture instance1 = new InheritedReflectionStaticFieldsFixture();
    String result1 = ReflectionToStringBuilder.toString(instance1, null, false, true, InheritedReflectionStaticFieldsFixture.class);
    assertTrue(result1.contains("staticString2=staticString2"));
    assertTrue(result1.contains("staticInt2=67890"));
    assertEquals(2, result1.split(",").length);

    String result2 = ReflectionToStringBuilder.toString(instance1, null, false, true, SimpleReflectionStaticFieldsFixture.class);
    assertTrue(result2.contains("staticString2=staticString2"));
    assertTrue(result2.contains("staticInt2=67890"));
    assertTrue(result2.contains("staticString=staticString"));
    assertTrue(result2.contains("staticInt=12345"));
    assertEquals(4, result2.split(",").length);

    String result3 = this.toStringWithStatics(instance1, null, SimpleReflectionStaticFieldsFixture.class);
    assertTrue(result3.contains("staticString2=staticString2"));
    assertTrue(result3.contains("staticInt2=67890"));
    assertTrue(result3.contains("staticString=staticString"));
    assertTrue(result3.contains("staticInt=12345"));
