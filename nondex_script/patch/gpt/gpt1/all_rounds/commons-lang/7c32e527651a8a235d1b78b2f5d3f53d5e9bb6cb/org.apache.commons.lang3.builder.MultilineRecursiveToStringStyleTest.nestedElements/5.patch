test_code:

public void nestedElements() {
    final Customer customer = new Customer("Douglas Adams");
    final Bank bank = new Bank("ASF Bank");
    customer.bank = bank;
    
    // Split the expected string into parts that can be checked independently
    String customerPrefix = getClassPrefix(customer);
    String bankPrefix = getClassPrefix(bank);
    
    String actual = toString(customer);
    
    assertTrue(actual.contains(customerPrefix + "["));
    assertTrue(actual.contains("name=Douglas Adams"));
    assertTrue(actual.contains("bank=" + bankPrefix + "["));
    assertTrue(actual.contains("name=ASF Bank"));
    assertTrue(actual.contains("accounts=<null>"));
    assertTrue(actual.endsWith("]"));
}


