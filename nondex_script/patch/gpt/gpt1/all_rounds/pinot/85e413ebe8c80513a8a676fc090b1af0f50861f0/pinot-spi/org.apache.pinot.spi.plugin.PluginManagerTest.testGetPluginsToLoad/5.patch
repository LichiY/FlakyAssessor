public void testGetPluginsToLoad() {
    Plugin p1 = new Plugin("p1");
    Plugin p2 = new Plugin("p2");
    Plugin p3 = new Plugin("p3");

    Set<Plugin> plugins = new LinkedHashSet<>();
    plugins.add(p1);
    plugins.add(p2);
    plugins.add(p3);

    List<String> actualPluginNames = new ArrayList<>();
    for (Plugin plugin : plugins) {
        actualPluginNames.add(plugin.getName());
    }

    List<String> expectedPluginNames = Arrays.asList("p1", "p2", "p3");
    Assert.assertEquals(new HashSet<>(actualPluginNames), new HashSet<>(expectedPluginNames));
}


