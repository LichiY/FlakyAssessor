public void test_for_issue2() {
    VO2 vo = new VO2();
    vo.id = 123;
    vo.properties.put("latitude", 37);
    vo.properties.put("longitude", 127);

    Object obj = JSON.toJSON(vo);
    String text = JSON.toJSONString(obj, SerializerFeature.SortField);
    
    Configuration configuration = Configuration.builder()
        .options(Option.DEFAULT_PATH_LEAF_TO_NULL)
        .jsonProvider(new JacksonJsonProvider())
        .mappingProvider(new JacksonMappingProvider())
        .build();
    
    Object document = configuration.jsonProvider().parse(text);
    assertEquals(37, JsonPath.read(document, "$.latitude"));
    assertEquals(123, JsonPath.read(document, "$.id"));
    assertEquals(127, JsonPath.read(document, "$.longitude"));
}


