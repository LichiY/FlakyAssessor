public void testToJson() {
    TestObject testObject = generateTestObject();
    
    JsonElement expected = new JsonParser().parse(EXPECTED_JSON);
    JsonElement actual = new JsonParser().parse(GsonUtils.getInstance().toJson(testObject));
    
    JsonObject expectedObj = expected.getAsJsonObject();
    JsonObject actualObj = actual.getAsJsonObject();
    
    Set<Map.Entry<String, JsonElement>> expectedEntries = new TreeSet<>(Comparator.comparing(Map.Entry::getKey));
    expectedEntries.addAll(expectedObj.entrySet());
    
    Set<Map.Entry<String, JsonElement>> actualEntries = new TreeSet<>(Comparator.comparing(Map.Entry::getKey));
    actualEntries.addAll(actualObj.entrySet());
    
    Assert.assertEquals(expectedEntries, actualEntries);
}


