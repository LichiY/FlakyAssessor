    Map<String, Object> bMap = new LinkedHashMap<>();
    bMap.put("x", "y2");
    expected.put("a", aMap);
    expected.put("b", bMap);
    
    assertEquals(JSON.toJSONString(expected), JSON.toJSONString(jsonObject));
}


