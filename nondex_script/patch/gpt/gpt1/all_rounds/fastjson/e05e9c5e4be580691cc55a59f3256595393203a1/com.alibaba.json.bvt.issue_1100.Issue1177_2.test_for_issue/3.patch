    System.out.println(JSON.toJSONString(jsonObject));
    String jsonpath = "$..x";
    String value="y2";
    JSONPath.set(jsonObject, jsonpath, value);
    
    Map<String, Object> expected = new LinkedHashMap<>();
    Map<String, Object> aMap = new LinkedHashMap<>();
