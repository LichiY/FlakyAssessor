public void test_for_multimap() throws Exception {
    ArrayListMultimap<String, Integer> multimap = ArrayListMultimap.create();
    multimap.putAll("b", Ints.asList(2, 4, 6));
    multimap.putAll("a", Ints.asList(4, 2, 1));
    multimap.putAll("c", Ints.asList(2, 5, 3));

    String json = JSON.toJSONString(multimap);
    Map<String, List<Integer>> parsedJson = JSON.parseObject(json, new TypeReference<Map<String, List<Integer>>>() {});
    assertEquals(parsedJson.get("a"), Arrays.asList(4, 2, 1));
    assertEquals(parsedJson.get("b"), Arrays.asList(2, 4, 6));
    assertEquals(parsedJson.get("c"), Arrays.asList(2, 5, 3));

    TreeMultimap treeMultimap = TreeMultimap.create(multimap);
    String json2 = JSON.toJSONString(treeMultimap);
    assertEquals("{\"a\":[1,2,4],\"b\":[2,4,6],\"c\":[2,3,5]}", json2);
}


