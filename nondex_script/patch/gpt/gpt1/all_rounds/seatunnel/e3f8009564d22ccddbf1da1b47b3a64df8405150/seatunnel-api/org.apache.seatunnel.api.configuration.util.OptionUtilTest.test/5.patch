public void test() throws InstantiationException, IllegalAccessException {
    List<Option<?>> options = OptionUtil.getOptions(TestOptionConfig.class);
    
    // Create a map to lookup options by key for reliable assertions
    Map<String, Option<?>> optionMap = new HashMap<>();
    for (Option<?> option : options) {
        optionMap.put(option.key(), option);
    }

    Option<?> shortOption = optionMap.get("short-value");
    Assertions.assertNotNull(shortOption);
    Assertions.assertEquals("shortValue", shortOption.getDescription());
    Assertions.assertEquals(Short.class, shortOption.typeReference().getType());

    Option<?> intOption = optionMap.get("int_value");
    Assertions.assertNotNull(intOption);
    Assertions.assertEquals(Integer.class, intOption.typeReference().getType());
    Assertions.assertEquals("", intOption.getDescription());
    Assertions.assertNull(intOption.defaultValue());

    // Verify all expected types are present regardless of order
    Set<Class<?>> expectedTypes = new HashSet<>(Arrays.asList(
        Long.class,
        Float.class,
        Double.class,
        String.class,
        Boolean.class,
        Byte.class,
        Character.class,
        TestOptionConfigEnum.class,
        TestOptionConfig.class,
        List.class,
        Map.class
    ));
    
    Set<Class<?>> actualTypes = new HashSet<>();
    for (Option<?> option : options) {
        actualTypes.add(option.typeReference().getType());
    }
    
    for (Class<?> expectedType : expectedTypes) {
        Assertions.assertTrue(actualTypes.contains(expectedType));
    }

    // Verify specific options with default values
    Option<?> stringOption = optionMap.get("default string");
    if (stringOption != null) {
        Assertions.assertEquals(String.class, stringOption.typeReference().getType());
    }

    Option<?> booleanOption = optionMap.get("true");
    if (booleanOption != null) {
        Assertions.assertEquals(Boolean.class, booleanOption.typeReference().getType());
    }

    Option<?> enumOption = optionMap.get(TestOptionConfigEnum.KEY2.toString());
    if (enumOption != null) {
        Assertions.assertEquals(TestOptionConfigEnum.class, enumOption.typeReference().getType());
        Assertions.assertEquals(TestOptionConfigEnum.KEY2, enumOption.defaultValue());
    }
}


