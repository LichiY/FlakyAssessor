public void shouldFindNthMostRepeatedElement() {
    int[] numbers = { 1, 1, 2, 3, 4, 5, 2, 2, 2, 4, 4, 6, 7, 4, 9, 214, 4, 5, };

    Map<Integer, Long> frequencyMap = new LinkedHashMap<>();
    for (int num : numbers) {
        frequencyMap.put(num, frequencyMap.getOrDefault(num, 0L) + 1);
    }

    List<Map.Entry<Integer, Long>> sortedEntries = new ArrayList<>(frequencyMap.entrySet());
    sortedEntries.sort(Map.Entry.<Integer, Long>comparingByValue().reversed());

    int result = sortedEntries.get(1).getKey();

    assertEquals(1, result);
}


