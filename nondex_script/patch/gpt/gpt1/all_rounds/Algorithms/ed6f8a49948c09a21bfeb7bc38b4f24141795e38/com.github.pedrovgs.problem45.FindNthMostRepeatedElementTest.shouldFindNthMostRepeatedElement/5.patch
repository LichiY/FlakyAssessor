public void shouldFindNthMostRepeatedElement() {
    int[] numbers = { 1, 1, 2, 3, 4, 5, 2, 2, 2, 4, 4, 6, 7, 4, 9, 214, 4, 5, };

    Map<Integer, Long> frequencyMap = new LinkedHashMap<Integer, Long>();
    for (int num : numbers) {
        frequencyMap.put(num, frequencyMap.getOrDefault(num, 0L) + 1);
    }

    List<Map.Entry<Integer, Long>> sortedEntries = new ArrayList<Map.Entry<Integer, Long>>(frequencyMap.entrySet());
    Collections.sort(sortedEntries, new Comparator<Map.Entry<Integer, Long>>() {
        @Override
        public int compare(Map.Entry<Integer, Long> o1, Map.Entry<Integer, Long> o2) {
            int valueComparison = o2.getValue().compareTo(o1.getValue());
            if (valueComparison != 0) {
                return valueComparison;
            }
            return o1.getKey().compareTo(o2.getKey());
        }
    });

    int result = sortedEntries.get(1).getKey();

    assertEquals(1, result);
}


