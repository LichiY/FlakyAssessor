@Test public void testInitFirstVerifyCallBacks() throws Exception {
    DefaultMetricsSystem.shutdown(); 
    new ConfigBuilder().add("*.period", 8)
        .add("test.sink.test.class", TestSink.class.getName())
        .add("test.*.source.filter.exclude", "s0")
        .add("test.source.s1.metric.filter.exclude", "X*")
        .add("test.sink.sink1.metric.filter.exclude", "Y*")
        .add("test.sink.sink2.metric.filter.exclude", "Y*")
        .save(TestMetricsConfig.getTestFilename("hadoop-metrics2-test"));
    MetricsSystemImpl ms = new MetricsSystemImpl("Test");
    ms.start();
    ms.register("s0", "s0 desc", new TestSource("s0rec"));
    TestSource s1 = ms.register("s1", "s1 desc", new TestSource("s1rec"));
    s1.c1.incr();
    s1.xxx.incr();
    s1.g1.set(2);
    s1.yyy.incr(2);
    s1.s1.add(0);
    MetricsSink sink1 = mock(MetricsSink.class);
    MetricsSink sink2 = mock(MetricsSink.class);
    ms.registerSink("sink1", "sink1 desc", sink1);
    ms.registerSink("sink2", "sink2 desc", sink2);
    ms.publishMetricsNow();

    ArgumentCaptor<MetricsRecord> r1 = ArgumentCaptor.forClass(MetricsRecord.class);
    ArgumentCaptor<MetricsRecord> r2 = ArgumentCaptor.forClass(MetricsRecord.class);

    try {
      verify(sink1, timeout(200).times(2)).putMetrics(r1.capture());
      verify(sink2, timeout(200).times(2)).putMetrics(r2.capture());
    } finally {
      ms.stop();
      ms.shutdown();
    }

    List<MetricsRecord> mr1 = r1.getAllValues();
    List<MetricsRecord> mr2 = r2.getAllValues();
    
    // Compare metrics without assuming order
    assertEquals("Number of records", mr1.size(), mr2.size());
    for (int i = 0; i < mr1.size(); i++) {
      MetricsRecord rec1 = mr1.get(i);
      MetricsRecord rec2 = mr2.get(i);
      assertEquals("Record name", rec1.name(), rec2.name());
      assertEquals("Record timestamp", rec1.timestamp(), rec2.timestamp());
      assertEquals("Number of metrics", rec1.metrics().size(), rec2.metrics().size());
      
      Map<String, MetricsInfo> metrics1 = new LinkedHashMap<>();
      Map<String, MetricsInfo> metrics2 = new LinkedHashMap<>();
      for (AbstractMetric metric : rec1.metrics()) {
        metrics1.put(metric.info().name(), metric.info());
      }
      for (AbstractMetric metric : rec2.metrics()) {
        metrics2.put(metric.info().name(), metric.info());
      }
      assertEquals("Metrics info", metrics1.keySet(), metrics2.keySet());
    }
  }


