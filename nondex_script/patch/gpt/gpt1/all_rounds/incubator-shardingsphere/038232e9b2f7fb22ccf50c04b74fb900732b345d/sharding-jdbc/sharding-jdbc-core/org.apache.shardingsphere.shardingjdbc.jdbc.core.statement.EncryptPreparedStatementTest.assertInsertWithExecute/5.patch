public void assertInsertWithExecute() throws SQLException {
    try (PreparedStatement statement = getEncryptConnection().prepareStatement(INSERT_SQL)) {
        statement.setObject(1, 2);
        statement.setObject(2, 'b');
        statement.execute();
    }
    try (ResultSet resultSet = getEncryptConnection().createStatement().executeQuery(SELECT_SQL)) {
        int count = 0;
        while (resultSet.next()) {
            count++;
            assertThat(resultSet.getInt(1), is(2));
            assertThat(resultSet.getString(2), is("encryptValue"));
            assertThat(resultSet.getString(3), is("assistedEncryptValue"));
        }
        assertThat(count, is(1));
    }
}


