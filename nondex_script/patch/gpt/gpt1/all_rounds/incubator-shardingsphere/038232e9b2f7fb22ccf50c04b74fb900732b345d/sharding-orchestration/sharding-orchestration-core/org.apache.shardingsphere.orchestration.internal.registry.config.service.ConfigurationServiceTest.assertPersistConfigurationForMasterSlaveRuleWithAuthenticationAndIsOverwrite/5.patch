        String expected1 = "users: root1: authorizedSchemas: sharding_db password: root1 root2: authorizedSchemas: sharding_db,ms_db password: root2 ";
        String expected2 = "users: root2: authorizedSchemas: sharding_db,ms_db password: root2 root1: authorizedSchemas: sharding_db password: root1 ";
        return argument.equals(expected1) || argument.equals(expected2);
    }));
    verify(regCenter).persist("/test/config/props", PROPS_YAML);
}


