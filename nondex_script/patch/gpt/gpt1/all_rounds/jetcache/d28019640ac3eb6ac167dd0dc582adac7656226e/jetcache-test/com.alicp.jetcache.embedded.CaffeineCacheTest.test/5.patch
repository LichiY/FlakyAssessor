    super.test(500, false);

    cache = EmbeddedCacheBuilder.createEmbeddedCacheBuilder()
            .buildFunc(getBuildFunc()).expireAfterWrite(100, java.util.concurrent.TimeUnit.MILLISECONDS).limit(2).build();
    cache.put("K1", "V1");
    cache.put("K2", "V2");
    cache.put("K3", "V3");
    
    Map<String, String> expectedValues = new LinkedHashMap<>();
    expectedValues.put("K2", "V2");
    expectedValues.put("K3", "V3");
    
    // Wait for expiration
    Thread.sleep(150);
    
    Map<String, String> actualValues = new LinkedHashMap<>();
    String value;
    if ((value = (String) cache.get("K1")) != null) {
        actualValues.put("K1", value);
    }
    if ((value = (String) cache.get("K2")) != null) {
        actualValues.put("K2", value);
    }
    if ((value = (String) cache.get("K3")) != null) {
        actualValues.put("K3", value);
    }
    
    assertEquals(expectedValues, actualValues);
}


