public void test() throws Exception {
    super.test(500, false);

    cache = EmbeddedCacheBuilder.createEmbeddedCacheBuilder()
            .buildFunc(getBuildFunc()).expireAfterWrite(100, java.util.concurrent.TimeUnit.MILLISECONDS).limit(2).build();
    cache.put("K1", "V1");
    cache.put("K2", "V2");
    cache.put("K3", "V3");
    
    // Wait for expiration
    Thread.sleep(150);
    
    Map<String, String> actualValues = new LinkedHashMap<>();
    for (String key : Arrays.asList("K1", "K2", "K3")) {
        String value = (String) cache.get(key);
        if (value != null) {
            actualValues.put(key, value);
        }
    }
    
    assertThat(actualValues.keySet(), containsInAnyOrder("K2", "K3"));
    assertThat(actualValues.values(), containsInAnyOrder("V2", "V3"));
}


