public void group_elements_by_length() {
    Map<Integer, List<String>> expected = new LinkedHashMap<>();
    expected.put(3, Arrays.asList("one", "two"));
    expected.put(5, Arrays.asList("three"));

    Map<Integer, List<String>> actual = new LinkedHashMap<>();
    actual.put(3, Arrays.asList("one", "two"));
    actual.put(5, Arrays.asList("three"));

    assertThat(actual).isEqualTo(expected);
}

