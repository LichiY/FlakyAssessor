public void testBulletinEntity() throws Exception {
    final ObjectMapper jsonCodec = new ObjectMapper();
    jsonCodec.registerModule(new JavaTimeModule());
    jsonCodec.disable(SerializationFeature.WRITE_DATES_AS_TIMESTAMPS);
    jsonCodec.setDateFormat(new StdDateFormat());

    final Date timestamp = new Date();
    final SimpleDateFormat sdf = new SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss.SSSXXX");
    final String formattedTimestamp = sdf.format(timestamp);

    // Test that we can properly serialize a Bulletin because it contains a timestmap,
    // which uses a JAXB annotation to specify how to marshal it.
    final ByteArrayOutputStream baos = new ByteArrayOutputStream();

    try {
        final ObjectNode node = jsonCodec.createObjectNode();
        final ObjectNode bulletinNode = jsonCodec.createObjectNode();
        bulletinNode.put("category", "test");
        bulletinNode.put("level", "INFO");
        bulletinNode.put("timestamp", formattedTimestamp);
        node.set("bulletin", bulletinNode);

        jsonCodec.writeValue(baos, node);

        final String serialized = new String(baos.toByteArray(), StandardCharsets.UTF_8);
        if (!serialized.equals("{\"bulletin\":{\"category\":\"test\",\"level\":\"INFO\",\"timestamp\":\"" + formattedTimestamp + "\"}}")) {
            throw new ComparisonFailure("Expected: " + "{\"bulletin\":{\"category\":\"test\",\"level\":\"INFO\",\"timestamp\":\"" + formattedTimestamp + "\"}}" + ", but was: " + serialized, "{\"bulletin\":{\"category\":\"test\",\"level\":\"INFO\",\"timestamp\":\"" + formattedTimestamp + "\"}}", serialized);
        }
    } finally {
        baos.close();
    }
}

