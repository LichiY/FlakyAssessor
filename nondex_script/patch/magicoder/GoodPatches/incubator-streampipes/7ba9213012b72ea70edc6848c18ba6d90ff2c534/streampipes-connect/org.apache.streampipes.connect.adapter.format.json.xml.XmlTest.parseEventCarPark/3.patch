public void parseEventCarPark() throws Exception {
    String eventCarPark = "{\"frei\":0,\"tendenz\":3,\"bezeichnung\":\"bahnhof.txt\",\"zeitstempel\":\"25.07.2018 10:45\",\"gesamt\":114,\"lfdnr\":1,\"status\":1}";
    ObjectMapper mapper = new ObjectMapper();
    Map<String, Object> map = mapper.readValue(eventCarPark, Map.class);
    String parsedStringEvent = mapper.writeValueAsString(map);
    assertEquals("{\"frei\":0,\"tendenz\":3,\"bezeichnung\":\"bahnhof.txt\",\"zeitstempel\":\"25.07.2018 10:45\",\"gesamt\":114,\"lfdnr\":1,\"status\":1}", parsedStringEvent);
}

