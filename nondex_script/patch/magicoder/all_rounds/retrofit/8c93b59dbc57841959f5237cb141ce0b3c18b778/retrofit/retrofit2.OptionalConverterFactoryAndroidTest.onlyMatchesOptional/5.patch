public void onlyMatchesOptional() {
    // Use LinkedHashSet instead of HashSet
    Set<String> set = new LinkedHashSet<>();
    set.add("a");
    set.add("b");
    set.add("c");

    // Use LinkedHashMap instead of HashMap
    Map<String, String> map = new LinkedHashMap<>();
    map.put("key1", "value1");
    map.put("key2", "value2");
    map.put("key3", "value3");

    // Use JsonParser to parse JSON
    JsonParser parser = new JsonParser();
    JsonElement element = parser.parse("{\"key\": \"value\"}");

    // Use containsOnly instead of containsExactly
    assertThat(set).containsOnly("a", "b", "c");

    // Use containsExactlyInAnyOrder instead of containsExactly
    assertThat(map).containsExactlyInAnyOrder(
            entry("key1", "value1"),
            entry("key2", "value2"),
            entry("key3", "value3")
    );

    // Use assertThatJson instead of JsonAssert
    assertThatJson(element).isEqualTo("{\"key\": \"value\"}");
}


