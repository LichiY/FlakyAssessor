        assertEquals(2L, operator.numEventTimeTimers());
        assertEquals(4L, operator.getPQSize(42));
        assertEquals(1L, operator.getPQSize(43));
        assertTrue(!operator.hasNonEmptySharedBuffer(42));
        assertTrue(!operator.hasNonEmptySharedBuffer(43));

        operator.processWatermark(new Watermark(2L));

        verifyWatermark(operator.getOutput().poll(), Long.MIN_VALUE);
        verifyWatermark(operator.getOutput().poll(), 2L);

        // still the 2 keys
