        // for 43 the element entered the NFA and the PQ is empty

        assertEquals(2L, operator.numEventTimeTimers());
        assertTrue(operator.hasNonEmptySharedBuffer(42));
        assertEquals(1L, operator.getPQSize(42));
        assertTrue(operator.hasNonEmptySharedBuffer(43));
        assertTrue(!operator.hasNonEmptyPQ(43));

        operator.processElement(new StreamRecord<>(startEvent2, 4L));
        operator.processElement(new StreamRecord<Event>(middleEvent2, 5L));

        OperatorSubtaskState snapshot = operator.snapshot(0L, 0L);
        operator.close();

        CepOperator<Event, Integer, Map<String, List<Event>>> operator2 = getKeyedCepOperator(false);
        operator2.setup();
        operator2.initializeState(snapshot);
        operator2.open();

        operator2.processElement(new StreamRecord<>(endEvent1, 6L));
        operator2.processWatermark(11L);
        operator2.processWatermark(12L);

        // now we have 1 key because the 43 expired and was removed.
        // 42 is still there due to startEvent2
        assertEquals(1L, operator2.numEventTimeTimers());
        assertTrue(operator2.hasNonEmptySharedBuffer(42));
        assertEquals(1L, operator2.getPQSize(42));
        assertTrue(operator2.hasNonEmptySharedBuffer(43));
        assertTrue(!operator2.hasNonEmptyPQ(43));

        verifyPattern(operator2.getOutput().poll(), startEvent1, middleEvent1, endEvent1);
        verifyPattern(operator2.getOutput().poll(), startEvent1, middleEvent2, endEvent1);
        verifyPattern(operator2.getOutput().poll(), startEvent2, middleEvent2, endEvent1);
