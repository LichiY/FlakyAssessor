    Event startEventK2 = new Event(43, "start", 1.0);

    StreamExecutionEnvironment env = StreamExecutionEnvironment.getExecutionEnvironment();
    CepOperator<Event, Integer, Map<String, List<Event>>> operator = getKeyedCepOperator(false);

    try {
        env.execute("CEP operator test");

        operator.processWatermark(new Watermark(Long.MIN_VALUE));

        operator.processElement(new StreamRecord<>(new Event(42, "foobar", 1.0), 2L));
        operator.processElement(new StreamRecord<Event>(middleEvent1, 2L));
        operator
            .processElement(new StreamRecord<Event>(new SubEvent(42, "barfoo", 1.0, 5.0), 3L));
        operator.processElement(new StreamRecord<>(startEvent1, 1L));
        operator.processElement(new StreamRecord<>(startEventK2, 1L));

