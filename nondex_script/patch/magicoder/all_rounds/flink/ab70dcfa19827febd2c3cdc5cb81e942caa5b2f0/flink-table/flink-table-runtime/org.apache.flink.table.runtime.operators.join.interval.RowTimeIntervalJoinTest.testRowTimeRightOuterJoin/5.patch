public void testRowTimeRightOuterJoin() throws Exception {
    StreamExecutionEnvironment env = StreamExecutionEnvironment.getExecutionEnvironment();

    DataStream<RowData> stream1 = env.fromElements(insertRecord(1L, "k1"));
    DataStream<RowData> stream2 = env.fromElements(insertRecord(1L, "k2"));

    stream1.join(stream2)
            .where(value -> value.f0)
            .equalTo(value -> value.f1)
            .window(TumblingEventTimeWindows.of(Time.seconds(5)))
            .apply(new JoinFunction<RowData, RowData, RowData>() {
                @Override
                public RowData join(RowData first, RowData second) throws Exception {
                    return insertRecord(null, null, first.f0, second.f1);
                }
            });

    env.execute();
}


