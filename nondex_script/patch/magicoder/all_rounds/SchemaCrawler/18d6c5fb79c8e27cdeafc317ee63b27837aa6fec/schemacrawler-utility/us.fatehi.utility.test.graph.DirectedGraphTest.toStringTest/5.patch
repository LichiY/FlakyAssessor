public void toStringTest() throws Exception {
    DirectedGraph<String> graph = new DirectedGraph<>();
    graph.addNode("A");
    graph.addNode("B");
    graph.addEdge(new Edge<>("A", "B"));

    ObjectMapper mapper = new ObjectMapper();
    JsonNode json = mapper.readTree(graph.toString());

    assertThat(json.get("nodes").size(), is(2));
    assertThat(json.get("edges").size(), is(1));

    assertThat(json.get("nodes").get(0).asText(), is("A"));
    assertThat(json.get("nodes").get(1).asText(), is("B"));

    assertThat(json.get("edges").get(0).get("from").asText(), is("A"));
    assertThat(json.get("edges").get(0).get("to").asText(), is("B"));
}


