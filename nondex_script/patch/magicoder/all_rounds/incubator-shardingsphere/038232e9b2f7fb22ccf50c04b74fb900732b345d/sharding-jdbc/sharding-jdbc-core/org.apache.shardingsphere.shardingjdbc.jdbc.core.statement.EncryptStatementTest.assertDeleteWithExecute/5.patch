    public void assertDeleteWithExecute() throws SQLException {
        try (Statement statement = getEncryptConnection().createStatement()) {
            statement.execute(DELETE_SQL);
        }
        ResultSet resultSet = getEncryptConnection().createStatement().executeQuery(SELECT_SQL);
        List<Map<String, Object>> resultList = new ArrayList<>();
        ResultSetMetaData metaData = resultSet.getMetaData();
        while (resultSet.next()) {
            Map<String, Object> row = new HashMap<>();
            for (int i = 1; i <= metaData.getColumnCount(); i++) {
                row.put(metaData.getColumnName(i), resultSet.getObject(i));
            }
            resultList.add(row);
        }
        Assertions.assertEquals(resultList.size(), resultSet.getRow());
        Assertions.assertEquals(resultList.get(0).get("encryptValue"), "b");
    }


