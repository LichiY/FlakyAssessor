test_code:

    public void assertPersistConfigurationForMasterSlaveRuleWithAuthenticationAndIsNotOverwriteAndConfigurationIsNotExisted() {
        RegCenter regCenter = new RegCenter();
        ConfigurationService configurationService = new ConfigurationService("test", regCenter);
        Map<String, String> dataSourceConfigurations = new HashMap<>();
        dataSourceConfigurations.put("ds1", "ds1");
        Map<String, String> masterSlaveRuleConfiguration = new HashMap<>();
        masterSlaveRuleConfiguration.put("ms1", "ms1");
        Map<String, String> authentication = new HashMap<>();
        authentication.put("auth1", "auth1");
        Map<String, String> properties = new HashMap<>();
        properties.put("prop1", "prop1");
        configurationService.persistConfiguration("sharding_db",
                dataSourceConfigurations, masterSlaveRuleConfiguration, authentication, properties, false);
        JsonObject dataSourceJson = new JsonObject();
        dataSourceConfigurations.forEach((key, value) -> dataSourceJson.addProperty(key, value));
        regCenter.persist(String.format("/test/config/schema/sharding_db/datasource"), gson.toJson(dataSourceJson));
        JsonObject masterSlaveRuleJson = new JsonObject();
        masterSlaveRuleConfiguration.forEach((key, value) -> masterSlaveRuleJson.addProperty(key, value));
        regCenter.persist("/test/config/schema/sharding_db/rule", gson.toJson(masterSlaveRuleJson));
        JsonObject authenticationJson = new JsonObject();
        authentication.forEach((key, value) -> authenticationJson.addProperty(key, value));
        regCenter.persist("/test/config/authentication", gson.toJson(authenticationJson));
        JsonObject propertiesJson = new JsonObject();
        properties.forEach((key, value) -> propertiesJson.addProperty(key, value));
        regCenter.persist("/test/config/props", gson.toJson(propertiesJson));
    }


