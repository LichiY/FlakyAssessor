test_code:

    public void testImport() throws Exception {
        ClassPathResource resource = new ClassPathResource("importing.xsd", getClass());
        CommonsXsdSchemaCollection schemaCollection = new CommonsXsdSchemaCollection(resource);
        schemaCollection.setInline(true);
        schemaCollection.afterPropertiesSet();
        definition = new DOMSource(schemaCollection.getSchema());

        definition.setPortTypeName("Order");
        definition.setTargetNamespace("http://www.springframework.org/spring-ws/import/definitions");
        definition.setLocationUri("http://localhost:8080/");
        definition.afterPropertiesSet();

        Document result = documentBuilder.parse(new DOMSource(definition.getSource()));
        Document expected = documentBuilder.parse(getClass().getResourceAsStream("import-inline.wsdl"));

        StringWriter writer = new StringWriter();
        transformer.transform(new DOMSource(result), new StreamResult(writer));
        String output = writer.toString();

        writer = new StringWriter();
        transformer.transform(new DOMSource(expected), new StreamResult(writer));
        String expectedOutput = writer.toString();

        Diff diff = DiffBuilder.compare(output).withTest(expectedOutput).checkForSimilar()
                .ignoreWhitespace().ignoreComments().build();

        if (diff.hasDifferences()) {
            throw new AssertionError("Invalid WSDL built", diff.getControlDetails(), diff.getTestDetails());
        }
    }


