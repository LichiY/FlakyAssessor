public void testGetQuery() {
    // Arrange
    String query = "{ \"name\": \"John\", \"age\": 30, \"city\": \"New York\" }";
    JsonParser parser = new JsonParser();

    // Act
    JsonElement jsonElement = parser.parse(query);

    // Assert
    assertThat(jsonElement.isJsonObject()).isTrue();
    assertThat(jsonElement.getAsJsonObject().has("name")).isTrue();
    assertThat(jsonElement.getAsJsonObject().has("age")).isTrue();
    assertThat(jsonElement.getAsJsonObject().has("city")).isTrue();
}


