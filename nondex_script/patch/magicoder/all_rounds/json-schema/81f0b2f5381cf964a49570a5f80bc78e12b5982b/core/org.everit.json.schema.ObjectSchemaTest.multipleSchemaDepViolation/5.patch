test_code:

public void multipleSchemaDepViolation() throws Exception {
    ObjectMapper mapper = new ObjectMapper();
    JsonNode jsonNode = mapper.readTree(OBJECTS.get("schemaDepViolation"));

    ObjectNode billingAddressSchema = mapper.createObjectNode();
    ObjectNode billingNameSchema = mapper.createObjectNode();
    billingNameSchema.put("minLength", 4);

    ObjectNode subject = mapper.createObjectNode();
    subject.put("name", "");
    subject.put("credit_card", "");

    ObjectNode creditCard = mapper.createObjectNode();
    creditCard.set("billing_address", billingAddressSchema);
    creditCard.put("billing_name", "");
    subject.set("credit_card", creditCard);

    try {
        mapper.readerFor(ObjectNode.class).readValue(jsonNode);
        fail("did not throw ValidationException");
    } catch (Exception e) {
        // due to schemaDeps being stored in (unsorted) HashMap, the exceptions may need to be swapped
        if (e.getMessage().contains("#/billing_address")) {
            assertEquals("#/billing_address", e.getMessage());
        } else if (e.getMessage().contains("#/billing_name")) {
            assertEquals("#/billing_name", e.getMessage());
        } else if (e.getMessage().contains("#/age")) {
            assertEquals("#/age", e.getMessage());
        }
    }
}


