public void testNestedExplicitNullValue() throws Exception {
    System.out.println("testNestedExplicitNullValue");
    ObjectMapper mapper = new ObjectMapper();

    ObjectNode rootNode = mapper.createObjectNode();
    ObjectNode structColNode = mapper.createObjectNode();
    structColNode.put("name", "myName");
    rootNode.set("structCol", structColNode);

    ObjectNode structNullColNode = mapper.createObjectNode();
    structNullColNode.putNull("name");
    rootNode.set("structNullCol", structNullColNode);

    rootNode.putNull("missingStructCol");

    String jsonStr = mapper.writeValueAsString(rootNode);

    JsonNode node = mapper.readTree(jsonStr);
    JsonNode structColNode2 = node.get("structCol");
    assertEquals("myName", structColNode2.get("name").asText());

    JsonNode structNullColNode2 = node.get("structNullCol");
    assertNull(structNullColNode2.get("name"));

    assertNull(node.get("missingStructCol"));

    assertEquals(jsonStr, "{\"missingStructCol\":null,\"structCol\":{\"name\":\"myName\"},\"structNullCol\":{\"name\":null}}");
}


