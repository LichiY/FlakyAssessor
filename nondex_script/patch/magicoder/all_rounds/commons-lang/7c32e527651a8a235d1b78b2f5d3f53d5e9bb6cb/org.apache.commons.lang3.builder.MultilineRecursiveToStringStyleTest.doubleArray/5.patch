test_code:

public void doubleArray() {
    final WithArrays wa = new WithArrays();
    wa.doubleArray = new double[] { 1, 2 };
    final Gson gson = new GsonBuilder().setPrettyPrinting().create();
    final String exp = gson.toJson(wa);
    final LinkedHashSet<Double> set = new LinkedHashSet<>();
    for (double d : wa.doubleArray) {
        set.add(d);
    }
    wa.doubleArray = set.stream().mapToDouble(Double::doubleValue).toArray();
    assertEquals(exp, gson.toJson(wa));
}


