public void itHandlesAnnotatedGenericFieldSerialization() {
    // Arrange
    TypeInfo expectedTypeInfo = new TypeInfo();
    expectedTypeInfo.setGeneralValue("General");
    expectedTypeInfo.setConcreteValue("internal");
    expectedTypeInfo.setType("concrete");

    // Act
    TypeInfo actualTypeInfo = new TypeInfo();
    actualTypeInfo.setGeneralValue("Gener");
    actualTypeInfo.setConcreteValue("internal");
    actualTypeInfo.setType("concrete");

    // Assert
    assertThat(ToStringBuilder.reflectionToString(actualTypeInfo, ToStringStyle.SHORT_PREFIX_STYLE))
            .isEqualTo(ToStringBuilder.reflectionToString(expectedTypeInfo, ToStringStyle.SHORT_PREFIX_STYLE));
}


