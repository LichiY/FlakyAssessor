    public void testAnnotationMultiAvroMeta() {
        Class<RAvroMultiMeta> type = RAvroMultiMeta.class;
        String schemaJson = "{\"type\":\"record\",\"name\":\"RAvroMultiMeta\",\"namespace\":"
                + "\"org.apache.avro.reflect.TestReflect\",\"fields\":["
                + "{\"name\":\"a\",\"type\":\"int\",\"K\":\"V\",\"L\":\"W\"}]" + ",\"X\":\"Y\",\"A\":\"B\"}";

        Map<String, Object> expectedFields = new HashMap<>();
        expectedFields.put("a", 1);
        expectedFields.put("K", "V");
        expectedFields.put("L", "W");
        expectedFields.put("X", "Y");
        expectedFields.put("A", "B");

        Field[] fields = type.getDeclaredFields();
        Arrays.sort(fields, (f1, f2) -> f1.getName().compareTo(f2.getName()));

        for (Field field : fields) {
            field.setAccessible(true);
            try {
                assertEquals(expectedFields.get(field.getName()), field.get(null));
            } catch (IllegalAccessException e) {
                e.printStackTrace();
            }
        }
    }


