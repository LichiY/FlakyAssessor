public void testGetByComponent() {
    // Arrange
    Client clientA = new Client("Client-A");
    Client clientB = new Client("Client-B");
    Client clientC = new Client("Client-C");
    Client clientD = new Client("Client-D");
    Client clientE = new Client("Client-E");

    List<Client> clients = Arrays.asList(clientA, clientB, clientC, clientD, clientE);

    // Act
    List<Client> result = getByComponent(clients);

    // Assert
    Assertions.assertThat(result)
        .containsExactly(clientA, clientB, clientC, clientD, clientE);
}


