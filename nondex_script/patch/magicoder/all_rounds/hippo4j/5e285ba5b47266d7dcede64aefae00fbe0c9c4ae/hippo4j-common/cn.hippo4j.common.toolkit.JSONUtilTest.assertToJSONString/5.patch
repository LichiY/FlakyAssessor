    public static void assertToJSONString() throws Exception {
        ObjectMapper mapper = new ObjectMapper();
        Id id = new Id();
        id.id = 1;
        id.name = "foo1";
        id.foo = new Foo();
        id.foo.id = 2;
        id.foo.name = "foo2";

