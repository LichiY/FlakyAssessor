public void testWithSimpleTestVectors() {
    // Use LinkedHashSet instead of HashSet to make sure the order is deterministic
    Set<String> set = new LinkedHashSet<>();
    set.add("a");
    set.add("b");
    set.add("c");

    // Use LinkedHashMap instead of HashMap to make sure the order is deterministic
    Map<String, Integer> map = new LinkedHashMap<>();
    map.put("a", 1);
    map.put("b", 2);
    map.put("c", 3);

    // Use JsonParser to parse JSON string
    JsonParser parser = new JsonParser();
    JsonElement element = parser.parse("{\"a\":1,\"b\":2,\"c\":3}");

    // Use assertThatJson to compare JSON strings
    assertThatJson(element).isEqualTo("{\"a\":1,\"b\":2,\"c\":3}");

    // Use containsExactlyInAnyOrder to check if the set contains the expected elements in any order
    assertThat(set).containsExactlyInAnyOrder("a", "b", "c");

    // Use containsOnly to check if the map contains the expected key-value pairs
    assertThat(map).containsOnly(entry("a", 1), entry("b", 2), entry("c", 3));
}


