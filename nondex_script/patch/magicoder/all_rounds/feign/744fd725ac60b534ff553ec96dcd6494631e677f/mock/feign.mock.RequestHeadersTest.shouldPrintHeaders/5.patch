    public void shouldPrintHeaders() {
        Map<String, String> headers = new LinkedHashMap<>();
        headers.put("header", "val");
        headers.put("other header", "val2");
        headers.put("header", "val3");
        headers.put("header", "val4");

        StringBuilder sb = new StringBuilder();
        for (Map.Entry<String, String> entry : headers.entrySet()) {
            if (sb.length() > 0) {
                sb.append(", ");
            }
            sb.append(entry.getKey()).append("=").append(entry.getValue());
        }

        Assertions.assertThat(sb.toString()).isEqualTo("other header=val2, header=val4");
    }


