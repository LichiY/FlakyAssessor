    expectedUsers.add(new User("user1"));

    assertEquals(expectedUsers, users);
    assertNotNull(ldapUserGroupProvider.getUserByIdentity("user1"));
    assertTrue(ldapUserGroupProvider.getGroups().isEmpty());
}


