                " <body>my message</body>\n" + 
                "</html>", r.body());
        context.assertEquals("text/html", r.getHeader("Content-Type"));
        return r;
    })
    .doOnError(x -> context.fail(x))
    .subscribe(response -> {
        async.complete();
    });
}


