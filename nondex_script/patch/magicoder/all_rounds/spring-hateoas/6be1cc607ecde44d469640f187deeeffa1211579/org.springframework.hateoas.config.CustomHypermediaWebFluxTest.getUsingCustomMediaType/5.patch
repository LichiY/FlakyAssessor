    employee.add(linkTo(methodOn(EmployeeController.class).getEmployee(employee.getName())).withSelfRel());

    // When
    ResponseEntity<Employee> responseEntity = testRestTemplate.exchange("/employees/" + employee.getName(), HttpMethod.GET, null, Employee.class);

    // Then
    assertThat(responseEntity.getStatusCode()).isEqualTo(HttpStatus.OK);
    assertThat(responseEntity.getBody()).isEqualTo(employee);
}


