public void testGenerateNewDayPairs() {
    Pair pair = new Pair();
    pair.setId(1L);
    pair.setName("Test Pair");

    DayPairs dayPairs = new DayPairs();
    dayPairs.setId(1L);
    dayPairs.setName("Test Day Pairs");
    dayPairs.setPair(pair);

    when(trelloPairsRepository.save(any(Pair.class))).thenReturn(pair);
    when(dayPairsRepository.save(any(DayPairs.class))).thenReturn(dayPairs);

    DayPairs result = dayPairsService.generateNewDayPairs(dayPairs);

    assertThat(result).isNotNull();
    assertThat(result.getId()).isEqualTo(dayPairs.getId());
    assertThat(result.getName()).isEqualTo(dayPairs.getName());
    assertThat(result.getPair()).isEqualTo(dayPairs.getPair());
}


