    public void testRTL() throws IOException {
        File file = new File("src/test/resources/technology/tabula/arabic.pdf");
        PDDocument document = PDDocument.load(file);
        PDFTextStripper stripper = new PDFTextStripper();
        String text = stripper.getText(document);
        document.close();

        String[] lines = text.split("\n");

        assertEquals("اسمي سلطان", lines[1]);
        assertEquals("من اين انت؟", lines[2]);
        assertEquals("1234", lines[3]);
        assertEquals("هل انت شباك؟", lines[4]);
        assertEquals("انا من ولاية كارولينا الشمال", lines[2]); // conjoined lam-alif gets missed
        assertEquals("اسمي Jeremy في الانجليزية", lines[4]); // conjoined lam-alif gets missed
        assertEquals("عندي 47 قطط", lines[3]); // the real right answer is 47.
        assertEquals("Jeremy is جرمي in Arabic", lines[5]); // the real right answer is 47.
        assertEquals("مرحباً", lines[1]); // really ought to be ً, but this is forgiveable for now
    }


