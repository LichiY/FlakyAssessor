{
  "project_name": "FlakyPatchValidator",
  "seed": 66,
  "data": {
    "data_dir": "data/splits",
    "train_csv_file": "train.csv",
    "val_csv_file": "val.csv",     
    "test_csv_file": "test.csv", 
    "project_col": "project_name",
    "flaky_col": "flaky_code",
    "patch_col": "generated_patch",
    "label_col": "isCorrect",
    "time_col": "time_consume",
    "source_col": "source_file",
    "incorrect_type_col":"incorrect_type",
    "generated_source_marker_col":"augmented_source_marker"
  },
  "model": {
    "encoder_name": "/model/microsoft/unixcoder-base",
    "max_length": 512,
    "dnn_layers": [768, 128],
    "dropout_rate": 0.25
  },
  "train": {
    "output_dir": "outputs",
    "epochs": 100,
    "batch_size": 16,
    "early_stopping_patience": 20,
    "learning_rate": 1e-5,
    "optimizer": "AdamW",
    "weight_decay": 0.01,
    "lr_scheduler": "cosine",
    "use_weighted_loss": true,
    "pos_weight_multiplier": 0.6,
    "warmup_steps": 78,
    "device_setting": {
      "device": "cuda",
      "num_workers": 1
    },
    "log_steps": 50,
    "eval_strategy": "epoch"
  },
  "eval": {
    "batch_size": 1
  },
  "log": {
    "filename": "outputs/run.log",
    "level": "info"
  }
}
